        }
      }
    },
    "Intake → Parser → Filter(Macro) → Packager → Delivery. Filter and transformer only work on opened files; deliver an open file and the customer can't open it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş → Ayrıştırıcı → Filtre(Makro) → Paketleyici → Teslimat. Filtre ve dönüştürücü yalnızca açılmış dosyada çalışır; açık dosya teslim edilirse müşteri açamaz."
          }
        }
      }
    },
    "Last step: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son işlem: %@"
