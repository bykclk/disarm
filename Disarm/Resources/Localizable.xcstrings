    },
    "Files of the selected container type go right; everything else goes straight.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen kap türündeki dosyalar sağa gider; diğer her şey düz devam eder."
          }
        }
      }
    },
    "Encrypted: can't be opened or inspected": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifreli: açılamaz ve incelenemez"
          }
        }
